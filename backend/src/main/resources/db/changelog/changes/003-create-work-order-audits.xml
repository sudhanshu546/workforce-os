<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet author="system" id="003-create-work-order-audits">
        <createTable tableName="work_order_audits">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="work_order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="from_status" type="VARCHAR(255)"/>
            <column name="to_status" type="VARCHAR(255)"/>
            <column name="latitude" type="DOUBLE PRECISION"/>
            <column name="longitude" type="DOUBLE PRECISION"/>
            <column name="action_by" type="VARCHAR(255)"/>
            <column name="timestamp" type="TIMESTAMP"/>
            <column name="notes" type="TEXT"/>
            <column name="tenant_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="work_order_id"
                                 baseTableName="work_order_audits"
                                 constraintName="fk_wo_audit_work_order"
                                 referencedColumnNames="id"
                                 referencedTableName="work_orders"/>

        <createIndex indexName="idx_work_order_audit_order" tableName="work_order_audits">
            <column name="work_order_id"/>
        </createIndex>
        
        <createIndex indexName="idx_work_order_audit_tenant_lat" tableName="work_order_audits">
            <column name="tenant_id"/>
            <column name="latitude"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
