<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet author="system" id="002-add-performance-indexes">
        <!-- Add composite index for worker-service lookups -->
        <createIndex indexName="idx_worker_service_lookup" tableName="worker_supported_services">
            <column name="worker_id"/>
            <column name="service_id"/>
        </createIndex>
        
        <!-- Add composite index for invoice filtering and aggregation -->
        <createIndex indexName="idx_invoice_tenant_status" tableName="invoices">
            <column name="tenant_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>