<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="006-create-support-tables" author="workforce-os">
        <createTable tableName="support_tickets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_support_customer" references="customers(id)"/>
            </column>
            <column name="work_order_id" type="BIGINT">
                <constraints foreignKeyName="fk_support_work_order" references="work_orders(id)"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="priority" type="VARCHAR(50)"/>
            <column name="attachment_url" type="VARCHAR(255)"/>
            <column name="tenant_id" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createTable tableName="ticket_comments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ticket_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comment_ticket" references="support_tickets(id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_comment_user" references="users(id)"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_ticket_customer" tableName="support_tickets">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
